{
  "name": "howsure-web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-items": "node scripts/sync-items.js",
    "dev": "npm run sync-items && wrangler pages dev --ip 127.0.0.1 --port 8788",
    "migrate:local": "wrangler d1 migrations apply howsure --local",
    "pretest": "npm run sync-items",
    "test": "node --test test/*.test.js",
    "smoke": "bash test/smoke.sh"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
